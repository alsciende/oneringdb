<div class="modal fade" data-card-modal-target="modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" data-card-modal-target="title"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" data-card-modal-target="content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" class="btn btn-primary" data-card-modal-target="cardPageLink" data-action="card-modal#closeBeforeNavigating">Go to card page</a>
            </div>
        </div>
    </div>
</div>
