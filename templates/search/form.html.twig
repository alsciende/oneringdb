{% extends 'base.html.twig' %}

{% block title %}LotrTcgDB - Card Database for LOTR TCG{% endblock %}

{% block body %}
    <div class="container">
        <h1>Search for cards of LOTR TCG</h1>
        {{ form_start(form) }}
        <div class="row">
            <div class="col-sm">{{ form_row(form.name) }}</div>
            <div class="col-sm">{{ form_row(form.text) }}</div>
        </div>
        <div class="row">
            <div class="col-sm">{{ form_row(form.culture) }}</div>
            <div class="col-sm">{{ form_row(form.twilightCost) }}</div>
        </div>
        <div class="row">
            <div class="col-sm">{{ form_row(form.type) }}</div>
        </div>
        <div class="row">
            <div class="col-sm">{{ form_row(form.pack) }}</div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}