{% extends 'base.html.twig' %}

{% block title %}{{ card.fullTitle }}{% endblock %}

{% block body %}
    <div class="container">
        {% include card.detailTemplate %}

        {% if rulesetHistory %}
            <table class="table card-list mt-3">
                <thead>
                    <tr>
                        <th scope="col">Card</th>
                        <th scope="col">Ruleset</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rulesetHistory %}
                        <tr>
                            <td>
                                {% if row.card.id == card.id %}
                                    {{ row.card.fullTitle }}
                                {% else %}
                                    {% include 'component/_card_name_link.html.twig' with {card: row.card} %}
                                {% endif %}
                            </td>
                            <td>{{ row.ruleset.name }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <div class="d-flex justify-content-between mt-3">
            <div>
                {% if previousCard %}
                    <a href="{{ path('app_card', {id: previousCard.id}) }}">&laquo; {{ previousCard.fullTitle }}</a>
                {% endif %}
            </div>
            <div>
                {% if nextCard %}
                    <a href="{{ path('app_card', {id: nextCard.id}) }}">{{ nextCard.fullTitle }} &raquo;</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
