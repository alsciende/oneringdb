{% extends 'base.html.twig' %}

{% block title %}Card Database for the Lord of the Rings Trading Card Game{% endblock %}

{% block body %}
    <canvas class="d-block w-100 mb-4"
            style="height: 220px; "
            data-controller="ring"
            data-ring-font-url-value="{{ asset('fonts/tengwar-cursive.woff2') }}"
            aria-label="The One Ring"></canvas>
    <div class="px-4 py-5 my-5 text-center">
        <h1 class="display-5 fw-bold text-body-emphasis">OneRingDB</h1>
        <div class="col-lg-6 mx-auto">
            <p class="lead mb-4">Quickly search for cards of the game<br>Lord of the Rings TCG</p>
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                {{ render(controller('App\\Controller\\SearchController::form')) }}
            </div>
            <p class="lead my-4 mt-5">or browse the cards and explore the game!
            </p>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown"
                        aria-expanded="false">
                    Cultures
                </button>
                <ul class="dropdown-menu">
                    {% for id,name in cultures.all %}
                        <li><a class="dropdown-item" href="{{ path('app_culture', {culture:id}) }}">{{ name }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown"
                        aria-expanded="false">
                    Sets
                </button>
                <ul class="dropdown-menu">
                    {% for id,name in sets.all %}
                        <li><a class="dropdown-item" href="{{ path('app_published_set', {set:id}) }}">{{ name }}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
