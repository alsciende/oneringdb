<tr>
    <td><a href="{{ path('app_card', {id:card.id}) }}" class="card-title" data-controller="tooltip" data-bs-title="{{ card }}">{{ card.getFullTitle() }}</a></td>
    <td>Site {{ card.getSiteNumber() }}</td>
    <td>{{ card.getShadowNumber() }}</td>
    <td>{{ card.type.value | trans({}, 'types') }}</td>
    <td>{{ card.getCollectorInfo() }}</td>
</tr>
