{% for card in pagerfanta %}
    <div class="row my-2">
        <div class="col-1 d-none d-lg-block d-flex align-items-center justify-content-center h-100">
            <span class="fw-bold">{{ card.publishedSet.shorthand }}</span>
        </div>
        <div class="col-3">
            {% include 'component/_card_image.html.twig' %}
        </div>
        <div class="col border">
            <h2 class="mt-2">
                {% include 'component/_card_name_link.html.twig' with {card: card, class: 'card-name card-name-display'} %}
            </h2>
            <p>
                Culture: {% include 'component/_culture_hyperlink.html.twig' with {culture:card.culture} %}
            </p>
            {% if card.twilightCost is not null %}
            <p>
                Cost: {{ card.twilightCost }}
            </p>
            {% endif %}
            <p>
                Type: {% include 'component/_type_hyperlink.html.twig' %}
                {% if card.hasSubtype %}
                    &mdash; {{ card.subtype.value }}
                {% endif %}
            </p>
            <hr>
            {% include 'component/_card_effect.html.twig' %}
        </div>
    </div>
{% endfor %}